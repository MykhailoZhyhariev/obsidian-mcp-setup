# Copy to config.env (git-ignored) and edit. Sourced by the scripts in infra/.
# Contains no secrets: the bearer token is generated on the server.

# --- AWS ---------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_AZ=eu-central-1a
# AWS_PROFILE=default            # optional: named profile for the aws CLI

INSTANCE_NAME=obsidian-mcp
STATIC_IP_NAME=obsidian-mcp-ip
BLUEPRINT_ID=ubuntu_24_04
# Verified against `aws lightsail get-bundles` at provision time (it lists valid IDs on mismatch).
BUNDLE_ID=micro_3_0
# Daily auto-snapshot time, UTC, must be on the hour (Lightsail keeps the last 7).
SNAPSHOT_TIME_UTC=03:00

# --- Access ------------------------------------------------------------
# Public key installed as the ONLY authorized key for SSH_USER at first boot.
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
SSH_USER=ubuntu
# Leave empty to auto-detect your current public IPv4 (checkip.amazonaws.com).
# Otherwise a CIDR such as 203.0.113.7/32. Re-run infra/firewall.sh apply if your IP changes.
SSH_ALLOWED_CIDR=

# --- Public endpoint ---------------------------------------------------
# Domain whose A record will point at the static IP (create it yourself after provisioning).
DOMAIN=mcp.example.com
# Optional; used by Let's Encrypt for expiry notices.
ACME_EMAIL=

# Port 80 must be reachable by Let's Encrypt for certificate issuance/renewal (HTTP-01).
# Caddy answers only the ACME challenge and a redirect to https on it. Set to "false" only if
# you switch Caddy to a DNS-01 challenge (see README), otherwise issuance will fail.
OPEN_PORT_80_FOR_ACME=true
# "anthropic" (default) restricts 443 to infra/anthropic-ips.txt. "any" is for short debugging
# sessions only (e.g. to curl the endpoint yourself) -- re-apply with "anthropic" afterwards.
HTTPS_SOURCE=anthropic

# --- Server software ---------------------------------------------------
OBSIDIAN_HEADLESS_VERSION=latest
