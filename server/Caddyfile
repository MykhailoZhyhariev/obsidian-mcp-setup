{
	# __ACME_EMAIL_LINE__
	# Plain h1/h2 only: UDP/443 is closed at the Lightsail firewall, so don't advertise HTTP/3.
	servers {
		protocols h1 h2
	}
}

__DOMAIN__ {
	# Only the MCP endpoint is proxied; bearer-token auth is enforced by the MCP server itself.
	handle /mcp {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		respond "Not found" 404
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
